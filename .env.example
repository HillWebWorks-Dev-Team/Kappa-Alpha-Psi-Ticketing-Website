# Database (SQLite for local/demo — switch to Postgres for production)
# On Vercel UI preview, keep a placeholder file URL; set UI_PREVIEW=true
DATABASE_URL="file:./dev.db"
DIRECT_URL="file:./dev.db"

# Production (Supabase): use transaction pooler for the app, session for migrations.
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# UI-only deploy (no real DB / Stripe). Required for Vercel stakeholder preview.
UI_PREVIEW="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ORG_NAME="Legendary Entertainment Ticketing"

# Stripe — https://dashboard.stripe.com/apikeys
# Leave as placeholders to use Demo Checkout (no real card charges)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"

# Email via Resend — https://resend.com (optional; confirmation page always shows tickets)
# Domain verified: legendaryentertainmentticketing.com
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="Legendary Entertainment <tickets@legendaryentertainmentticketing.com>"

# Admin page password (/admin)
ADMIN_PASSWORD="kappaadmin@2026"

# Optional support contact shown on Tickets / Contact pages
NEXT_PUBLIC_SUPPORT_EMAIL="tickets@legendaryentertainmentticketing.com"
# Optional phone shown on Contact page (omit to hide)
# NEXT_PUBLIC_SUPPORT_PHONE="(404) 555-0123"
# Organizer inbox for contact-form notifications (falls back to SUPPORT_EMAIL / EMAIL_FROM)
# CONTACT_TO_EMAIL="x.tiaaantorres@gmail.com"
